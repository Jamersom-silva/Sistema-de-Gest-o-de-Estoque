<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edit_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do Produto *"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_codigo_barras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código de Barras"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_quantidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantidade *"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_preco_custo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Preço de Custo"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_preco_venda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Preço de Venda *"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/edit_descricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição"
        android:minLines="3"
        android:gravity="top"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_salvar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SALVAR PRODUTO" />

</LinearLayout>